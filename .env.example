# Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Secreto para firmar JWT de sesión (mínimo 32 caracteres). Generá uno aleatorio y no lo compartas.
JWT_SECRET=cambiar_por_un_string_largo_y_aleatorio_de_al_menos_32_chars
